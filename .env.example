# ===========================================
# ChargePilot 单客户部署环境变量模板
# 复制到 .env 后填充真实值,docker compose 会读取
# ===========================================

# 镜像 tag (CI 默认 latest;开发用 dev)
TAG=latest

# ---------------- 数据库 ------------------
MYSQL_ROOT_PASSWORD=change-me-root-pw
DB_PASSWORD=change-me-app-pw
# 5 个 schema 由迁移自动创建;DATABASE_URL 在 docker-compose 中拼接

# ---------------- Redis -------------------
REDIS_PASSWORD=change-me-cache-pw
REDIS_STREAM_PASSWORD=change-me-stream-pw

# ---------------- JWT / 内部通信 ------------
# openssl rand -hex 32  生成 64 字符 hex 串
JWT_SECRET=change-me-jwt-secret-64-hex-chars-please-rotate-quarterly
SERVICE_TOKEN=change-me-service-internal-token-also-64-hex-chars

# ---------------- 微信支付(商户号直连)-----
WECHAT_APPID=wx_your_appid
WECHAT_SECRET=your_app_secret
WECHAT_MCH_ID=your_merchant_id
WECHAT_PAY_KEY=your_32_byte_api_v3_key
# Merchant certificate serial number and merchant private key PEM (PKCS8 or PKCS1).
# Paths must exist inside the service/container; mount secret files read-only.
WECHAT_MERCHANT_SERIAL_NO=
WECHAT_PRIVATE_KEY_PATH=
# Pinned WeChat Pay public key ID and PEM PUBLIC KEY file (not merchant certificate).
WECHAT_PLATFORM_KEY_ID=
WECHAT_PLATFORM_PUBLIC_KEY_PATH=
WECHAT_NOTIFY_URL=https://your-domain.com/api/v1/public/payment/wechat/callback

# ---------------- 客户域名 ------------------
PUBLIC_DOMAIN=charge.example.com
ADMIN_BOOTSTRAP_USER=admin
# openssl 生成: argon2id hash;首启后请改密
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe!Admin2026
ADMIN_BOOTSTRAP_PHONE=+8613800000000

# ---------------- 可选: 阿里云 OSS / MinIO --
OTA_STORAGE_DRIVER=local            # local | s3 | minio
OTA_LOCAL_DIR=/var/lib/chargepilot/ota
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY=
OSS_SECRET_KEY=

# ---------------- 可选: 日志/可观测性 --------
RUST_LOG=info,sqlx=warn,tower_http=info
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------------- 可选: 计费规则默认值 -----
DEFAULT_TIME_OF_USE_JSON={"peak":{"start":"08:00","end":"21:00","rate_cents_per_kwh":80},"off":{"start":"21:00","end":"08:00","rate_cents_per_kwh":40}}
