{
    admin off
    log default {
        output stdout
        format json
    }
}

{$PUBLIC_DOMAIN} {
    encode zstd gzip
    header Strict-Transport-Security "max-age=63072000; includeSubDomains"
    header X-Content-Type-Options "nosniff"
    header X-Frame-Options "DENY"

    handle /api/* {
        reverse_proxy chargepilot-central:8080
    }

    handle_path /admin/* {
        root * /srv/admin
        try_files {path} /index.html
        file_server
    }

    redir / /admin/
}
