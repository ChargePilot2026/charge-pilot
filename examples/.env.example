# ChargePilot .env.example
# 配套文档:docs/技术规格.md § 10(部署)
#
# 用法:
#   1. cp examples/.env.example .env
#   2. 修改所有 ?? 后缀的值为客户实际配置
#   3. 所有密钥 / 密码通过本文件注入 docker-compose.yml(不读 config.yaml)

# ============ MySQL ============
# 客户首次部署时设置,后续不修改
MYSQL_ROOT_PASSWORD=??
# 各 schema 共享账号(应用层用,不是 root)
DB_PASSWORD=??

# ============ Redis ============
REDIS_PASSWORD=??

# ============ JWT 密钥(HS256)==========
# 长度 ≥ 32 字节,生产环境必须用 openssl rand -hex 32 生成
JWT_SECRET=??

# ============ 服务间共享密钥 ============
# 5 个服务共用同一 SERVICE_TOKEN,内部 HTTP 调用的 Authorization header
# 长度 ≥ 32 字节
SERVICE_TOKEN=??

# ============ 微信小程序(必填) ============
WECHAT_APPID=??
WECHAT_SECRET=??
# 微信支付 V3 API(商户号)
WECHAT_MCH_ID=??
# 微信支付 V3 API 密钥(32 字节)
WECHAT_PAY_KEY=??

# ============ 镜像版本(可选) ============
# 默认 latest,正式部署建议指定 tag 如 v1.0.0
TAG=latest

# ============ 告警 Webhook(可选) ============
# 证书续期 / 重大告警的 webhook 接收地址
# ALERT_WEBHOOK_URL=https://hooks.example.com/alert
# ALERT_WEBHOOK_SECRET=??