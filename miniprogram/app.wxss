/* ChargePilot Mini Program · 全局样式 */

page {
  --primary: #1677ff;
  --success: #52c41a;
  --warning: #faad14;
  --danger: #ff4d4f;
  --text: #333;
  --text-secondary: #666;
  --bg: #f5f5f5;
  background: var(--bg);
  color: var(--text);
  font-size: 14px;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
}

.container { padding: 16rpx 24rpx; }

.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,.04);
}

.btn-primary {
  background: var(--primary);
  color: #fff;
  border-radius: 8rpx;
  padding: 20rpx 0;
  text-align: center;
  font-size: 16px;
}

.text-secondary { color: var(--text-secondary); font-size: 12px; }

.tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 12px;
  margin-right: 8rpx;
}
.tag-blue { background: #e6f4ff; color: #1677ff; }
.tag-green { background: #f6ffed; color: #52c41a; }
.tag-red { background: #fff1f0; color: #ff4d4f; }
.tag-grey { background: #f5f5f5; color: #999; }
.tag-orange { background: #fff7e6; color: #fa8c16; }