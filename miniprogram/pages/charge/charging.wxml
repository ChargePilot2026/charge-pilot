<view class="container">
 <button wx:if="{{needsLogin}}" bindtap="login">登录查看充电状态</button>
 <view wx:if="{{loading && !snapshot}}" class="card">正在读取订单状态…</view>
 <view wx:if="{{error}}" class="card"><view>{{error}}</view><button bindtap="load" disabled="{{loading}}">重试</button></view>
 <block wx:if="{{snapshot}}">
  <view class="card"><view class="tag tag-blue">{{snapshot.statusLabel}}</view><view>{{snapshot.order_no}}</view>
   <view wx:if="{{snapshot.status === 'paid'}}">支付已确认，启动确认中；系统查询并重放同一个启动操作，请勿重复下单。</view>
   <view wx:if="{{snapshot.status === 'pending_payment'}}">订单等待支付确认，设备尚未开始充电。</view>
   <view wx:if="{{!snapshot.poll_continue}}">订单已结束，状态刷新已停止。</view>
  </view>
  <view class="card" wx:if="{{snapshot.status === 'charging'}}">
   <view wx:if="{{!snapshot.telemetry_available}}" class="text-secondary">暂未收到实时遥测数据。</view>
   <view wx:if="{{snapshot.display.show_power}}">功率：{{snapshot.powerText}} {{snapshot.display.hide_unit ? '' : 'W'}}</view><view>电压：{{snapshot.voltageText}} V</view><view>温度：{{snapshot.temperatureText}} °C</view>
   <button bindtap="loadCurve" loading="{{curveLoading}}" disabled="{{curveLoading}}">{{curve ? '刷新近 30 分钟曲线' : '查看近 30 分钟曲线'}}</button>
  </view>
  <view wx:if="{{curveError}}" class="card"><view>{{curveError}}</view><button bindtap="loadCurve" disabled="{{curveLoading}}">重试</button></view>
  <view wx:if="{{curve}}" class="card">
   <view>遥测曲线（采样间隔 {{curve.sample_interval_seconds}} 秒）</view>
   <view wx:if="{{!curve.series.length}}" class="text-secondary">该时间段没有设备遥测。</view>
   <view wx:for="{{curve.series}}" wx:key="ts" class="curve-row">
    <view>{{item.tsText}}<text wx:if="{{snapshot.display.show_power}}"> · {{item.powerText}} {{snapshot.display.hide_unit ? '' : 'W'}}</text> · {{item.currentText}} A · {{item.voltageText}} V · {{item.temperatureText}} °C</view>
   </view>
  </view>
  <view class="card"><view wx:if="{{snapshot.display.show_energy}}">累计电量：{{snapshot.energyText}} {{snapshot.display.hide_unit ? '' : 'kWh'}}</view><view>充电时长：{{snapshot.durationText}}</view><view>费用：{{snapshot.feeText}}</view></view>
  <view wx:if="{{snapshot.billing_status === 'manual_review'}}" class="card">计量不足，待管理员核对。暂不猜算收费。</view>
  <view wx:for="{{snapshot.card_operations}}" wx:key="operation_id" class="card">{{item.kind === 'extend' ? '加时' : '刷卡启动'}} {{item.minutes}} 分钟 · {{item.status === 'confirming' ? '确认中' : item.status === 'confirmed' ? '已确认' : '失败，已补偿退款'}}</view>
  <view wx:for="{{snapshot.tariff_lines}}" wx:key="*this" class="card">{{item}}</view>
  <view wx:if="{{snapshot.rule_description}}" class="card">{{snapshot.rule_description}}</view>
  <button bindtap="detail">查看订单详情</button>
  <button wx:if="{{snapshot.status === 'charging'}}" bindtap="stopCharge" loading="{{stopping}}" disabled="{{stopping || loading}}">停止充电</button>
  <view wx:if="{{stopNotice}}" class="card">{{stopNotice}}</view>
 </block>
</view>
