<view class="container">
  <view class="card" wx:if="{{snapshot}}">
    <view style="text-align: center;">
      <view class="text-secondary">实时功率</view>
      <view style="font-size: 56px; font-weight: 600; color: #1677ff;">{{snapshot.current_power_w}} <text style="font-size: 18px;">W</text></view>
    </view>
    <view style="display: flex; justify-content: space-between; margin-top: 32rpx;">
      <view><view class="text-secondary">已充电量</view><view>{{snapshot.charged_kwh}} kWh</view></view>
      <view><view class="text-secondary">当前费用</view><view>¥{{snapshot.current_cost}}</view></view>
      <view><view class="text-secondary">剩余时间</view><view>{{snapshot.estimated_remaining_min}} 分钟</view></view>
    </view>
    <view style="margin-top: 24rpx;" class="text-secondary">
      温度 {{snapshot.temperature_c}}°C · 电压 {{snapshot.voltage_v}}V · 已用 {{snapshot.elapsed_seconds}} 秒
    </view>
  </view>

  <view class="card">
    <view class="btn-primary" bindtap="stopCharge" style="background: #ff4d4f;">停止充电</view>
  </view>
</view>