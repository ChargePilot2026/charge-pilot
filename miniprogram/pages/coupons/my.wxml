<view class="container">
  <view wx:if="{{needsLogin}}" class="card"><view>登录后查看优惠券</view><button type="primary" bindtap="login">微信登录</button></view>
  <picker wx:else range="{{statusNames}}" value="{{statusIndex}}" bindchange="onStatus"><view class="card">状态：{{statusNames[statusIndex]}} ▾</view></picker>
  <view wx:for="{{items}}" wx:key="grant_id" class="coupon card">
    <view class="row"><view class="name">{{item.name}}</view><view class="discount">{{item.discountText}}</view></view>
    <view>{{item.typeText}} · 满 ¥{{item.minimumText}} 可用</view>
    <view class="text-secondary">有效期至 {{item.expiresText}}</view>
    <view class="tag">{{item.statusText}}</view>
  </view>
  <view wx:if="{{loading}}" class="card">正在读取优惠券…</view>
  <view wx:if="{{error}}" class="card error"><view>{{error}}</view><button bindtap="load" disabled="{{loading}}">重试</button></view>
  <view wx:if="{{!loading &amp;&amp; !error &amp;&amp; !items.length &amp;&amp; !needsLogin}}" class="card">当前没有{{statusNames[statusIndex]}}的优惠券</view>
  <button wx:if="{{items.length &lt; total &amp;&amp; !loading}}" bindtap="onReachBottom">加载更多</button>
  <button wx:if="{{!needsLogin}}" bindtap="goScan">去扫码充电</button>
</view>
