<view class="container">
  <view wx:if="{{needsLogin}}" class="card"><view>登录后联系在线客服</view><button type="primary" bindtap="login">微信登录</button></view>
  <view wx:elif="{{loading}}" class="card">正在查找可用客服…</view>
  <view wx:if="{{entry}}" class="card">
    <view class="heading">{{entry.agent_name || 'ChargePilot 客服'}}</view>
    <view class="text-secondary">咨询主题：{{scene === 'refund' ? '退款' : scene === 'complaint' ? '投诉' : '一般咨询'}}</view>
    <button wx:if="{{entry.available}}" type="primary" bindtap="openChat" loading="{{opening}}" disabled="{{opening}}">打开微信客服会话</button>
    <view wx:else class="notice">在线会话尚未完成配置，请复制客服微信号或稍后再试。</view>
    <button wx:if="{{entry.agent_wechat}}" bindtap="copyWechat">复制客服微信号 {{entry.agent_wechat}}</button>
  </view>
  <view wx:if="{{error}}" class="card error"><view>{{error}}</view><button bindtap="load" disabled="{{loading}}">重试</button></view>
  <view wx:if="{{!loading &amp;&amp; !error &amp;&amp; !entry &amp;&amp; !needsLogin}}" class="card">当前没有可用客服，请稍后重试。</view>
  <view class="card text-secondary">如反馈订单问题，请准备订单号；不要在客服消息中发送密码或支付验证码。</view>
</view>
