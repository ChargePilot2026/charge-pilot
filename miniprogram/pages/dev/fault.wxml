<view class="container">
  <view wx:if="{{needsLogin}}" class="card"><view>登录后提交设备报修</view><button type="primary" bindtap="login">微信登录</button></view>
  <view class="card">
    <view class="heading">设备报修</view>
    <view class="device">设备编号：{{deviceId || '未指定'}}</view>
    <picker range="{{faultTypes}}" value="{{faultTypeIndex}}" bindchange="onType"><view class="field">故障类型：{{faultTypes[faultTypeIndex]}} ▾</view></picker>
    <textarea placeholder="描述故障现象、发生时间和已尝试的处理方式" maxlength="2000" value="{{description}}" bindinput="onDescription" auto-height />
    <view class="text-secondary">请勿填写个人密码或支付信息。</view>
    <button type="primary" bindtap="submit" loading="{{submitting}}" disabled="{{submitting}}">提交报修</button>
  </view>
  <view wx:if="{{notice}}" class="card success">{{notice}}</view>
  <view wx:if="{{error}}" class="card error"><view>{{error}}</view><button bindtap="submit" disabled="{{submitting}}">重试</button></view>
  <view class="card">
    <view class="heading">我的报修</view>
    <view wx:for="{{reports}}" wx:key="report_id" class="report-row">
      <view class="report-head"><text>{{item.device_id}}</text><text class="status">{{item.statusText}}</text></view>
      <view class="text-secondary">报修单 {{item.report_id}} · {{item.createdText}}</view>
      <view wx:if="{{item.description}}" class="report-description">{{item.description}}</view>
      <button class="history-toggle" size="mini" data-report-id="{{item.report_id}}" bindtap="toggleHistory">{{expandedReport === item.report_id ? '收起处理记录' : '查看处理记录'}}</button>
      <view wx:if="{{expandedReport === item.report_id}}" class="history-box">
        <view wx:if="{{reportHistoryLoading}}" class="text-secondary">正在读取处理记录…</view>
        <view wx:for="{{reportHistory}}" wx:key="event_id" class="history-row"><view>{{item.eventText}} · {{item.createdText}}</view><view wx:if="{{item.fromStatusText || item.toStatusText}}" class="text-secondary">{{item.fromStatusText || '—'}} → {{item.toStatusText || '—'}}</view><view wx:if="{{item.note}}" class="history-note">{{item.note}}</view></view>
        <view wx:if="{{reportHistoryError}}" class="error"><view>{{reportHistoryError}}</view><button size="mini" data-report-id="{{item.report_id}}" bindtap="retryReportHistory">重试</button></view>
        <view wx:if="{{!reportHistoryLoading && !reportHistoryError && reportHistory.length === 0}}" class="text-secondary">暂无处理记录</view>
      </view>
    </view>
    <view wx:if="{{reports.length === 0 && !loadingReports}}" class="text-secondary">暂无报修记录</view>
    <view wx:if="{{historyError}}" class="error"><view>{{historyError}}</view><button bindtap="retryReports" loading="{{loadingReports}}">重试读取</button></view>
    <button wx:if="{{reportsHasMore}}" bindtap="loadMoreReports" loading="{{loadingReports}}">加载更多</button>
    <view wx:elif="{{loadingReports}}" class="text-secondary">正在读取报修进度…</view>
  </view>
</view>
