.container{padding:24rpx}.card{padding:28rpx;background:#fff;border-radius:16rpx;margin-bottom:20rpx}.heading{font-size:34rpx;font-weight:600;margin-bottom:18rpx}.device{color:#555;margin:18rpx 0}.field,textarea{padding:22rpx 12rpx;border-bottom:1rpx solid #eee;margin:12rpx 0;width:100%;box-sizing:border-box}.text-secondary{font-size:24rpx;color:#888;margin-bottom:24rpx}.success{color:#237804}.error{color:#a8071a}.report-row{padding:22rpx 0;border-bottom:1rpx solid #f0f0f0}.report-head{display:flex;justify-content:space-between;font-weight:600}.status{color:#1677ff}.report-description{font-size:26rpx;color:#444;white-space:pre-wrap;margin-top:8rpx}.history-toggle{margin:14rpx 0 0 0}.history-box{margin-top:12rpx;padding:16rpx;background:#f7f8fa;border-radius:8rpx}.history-row{padding:14rpx 0;border-bottom:1rpx solid #e8e8e8}.history-row:last-child{border-bottom:0}.history-note{font-size:25rpx;color:#555;white-space:pre-wrap;margin-top:6rpx}
