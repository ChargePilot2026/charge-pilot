<view class="container">
 <view wx:if="{{loading}}" class="card">正在读取端口信息…</view>
 <view wx:if="{{error}}" class="card"><view>{{error}}</view><button bindtap="load" disabled="{{loading || paying || startAttempted}}">重试</button></view>
 <view wx:if="{{deviceId}}" class="card"><view>设备 {{deviceId}}</view><view class="text-secondary">请核对插座编号后选择端口</view><view wx:if="{{!ports.length}}">该设备暂无可用端口信息</view></view>
 <view wx:for="{{ports}}" wx:key="port_id" class="card"><view>端口 {{item.port_no}} · {{item.statusLabel}}</view><view class="text-secondary">{{item.port_code}}</view><button data-id="{{item.port_id}}" bindtap="selectPort" disabled="{{loading || paying || startAttempted || !item.selectable}}">{{item.selectable ? '选择此端口' : '当前不可选择'}}</button></view>
 <view wx:if="{{selected}}" class="card"><view>已选端口 {{selected.port_no}} · {{selected.statusLabel}}</view>
  <block wx:if="{{selected.selectable}}"><view>选择充电套餐</view><view wx:if="{{stopWhenFull}}">支持满充停止，按实际消费退款。</view><view wx:if="{{!loading &amp;&amp; !offers.length}}">该站点尚未发布可用方案</view><view wx:for="{{offers}}" wx:key="id" class="card"><view>{{item.modeLabel}} · {{item.name}} · {{item.priceText}}</view><view>{{item.ruleText}}</view><view wx:if="{{display.fee_split_inline}}">{{item.mode === 'duration' ? '支付价格为时长套餐费' : item.mode === 'energy' ? '支付价格由冻结电费与服务费单价计算' : '按冻结电费与服务费结算，实收不超过预付金额'}}</view><button data-id="{{item.id}}" bindtap="selectOffer" disabled="{{paying || startAttempted}}">{{selectedOffer.id === item.id ? '已选择' : '选择'}}</button></view><button wx:if="{{selectedOffer &amp;&amp; (!startAttempted || canRetryPayment)}}" bindtap="pay" loading="{{paying}}" disabled="{{loading || paying}}">支付 {{selectedOffer.priceText}} 并充电</button></block>
  <view wx:else>此端口当前不可充电，请选择其他空闲端口。</view>
 </view>
 <view wx:if="{{paymentNotice}}" class="card">{{paymentNotice}}</view><view wx:if="{{startAttempted}}" class="card"><view wx:if="{{paymentNo}}">支付单号 {{paymentNo}} · {{feeText}}</view><button bindtap="history">查看订单记录</button></view><button bindtap="rescan" disabled="{{paying || startAttempted}}">重新扫码</button>
</view>
