<view class="container">
 <button wx:if="{{needsLogin}}" bindtap="login">登录查看退款</button>
 <view wx:if="{{!needsLogin}}" class="card">
  <view>申请原路退款</view><input aria-label="退款金额" type="digit" placeholder="金额（元）" value="{{amount}}" bindinput="inputAmount" disabled="{{pendingRetry || refunding}}"/>
  <input aria-label="退款原因" placeholder="退款原因（可选）" maxlength="255" value="{{reason}}" bindinput="inputReason" disabled="{{pendingRetry || refunding}}"/>
  <view wx:if="{{pendingRetry}}">上次申请结果尚未确认，重试将沿用同一申请，不会重复预留余额。</view>
  <button bindtap="submit" loading="{{refunding}}" disabled="{{loading || refunding}}">{{pendingRetry ? '重试同一申请' : '申请退款'}}</button>
 </view>
 <view wx:if="{{notice}}" class="card">{{notice}}</view>
 <view wx:if="{{error}}" class="card">{{error}}<button bindtap="load">刷新记录</button></view>
 <view wx:if="{{loading}}">正在读取退款进度…</view>
 <view wx:for="{{items}}" wx:key="request_id" class="card">
  <view>{{item.amountText}} · {{item.statusText}}</view><view>已退款 {{item.refundedText}}</view><view class="text-secondary">{{item.created_at}}</view>
  <view wx:for="{{item.refund_orders}}" wx:for-item="part" wx:key="refund_no"><view>{{part.amountText}} · {{part.statusText}}</view><view class="text-secondary">{{part.refund_no}}</view><view wx:if="{{part.failure_reason}}">{{part.failure_reason}}</view></view>
 </view>
 <view wx:if="{{!loading &amp;&amp; !items.length &amp;&amp; !needsLogin}}">暂无退款申请</view>
</view>
