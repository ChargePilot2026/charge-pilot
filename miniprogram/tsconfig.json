{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "allowJs": true, "checkJs": false,
    "esModuleInterop": true, "skipLibCheck": true, "strict": false,
    "resolveJsonModule": true, "types": ["@tarojs/taro"], "noEmit": true
  },
  "include": ["src", "config"]
}
